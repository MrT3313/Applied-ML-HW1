# Every step of the W&B workflow as a make target. Run them from inside Q1_WandB:
#
#     make -f Makefile.WeightsAndBiases <target>
#
# Usual order:
#     register-data-artifacts    once, uploads the CSVs to the server
#     run-sweep                  per experiment, runs the grid and writes the comparison onto the runs
#                                (run-dummy-sweep, run-closed-form-sweep and run-sgd-sweep are shortcuts for
#                                one sweep file each)
#     promote RUN=<run_id>       after choosing a run in the UI, saves its model
#     final-eval                 once, scores the promoted model on the test set
#
# Needs the local W&B server running (wandb server start) and a login to it
# (wandb login --host=http://localhost:8080).

.PHONY: register-data-artifacts run-sweep run-dummy-sweep run-closed-form-sweep run-sgd-sweep compare promote final-eval

# the Python that has wandb installed. Override with: make ... PYTHON=/path/to/python
PYTHON ?= conda run --no-capture-output -n homl3 python

# the sweep file run-sweep uses. Override with: make ... run-sweep SWEEP=configs/sweeps/<file>.yaml
SWEEP ?= configs/sweeps/linear_regression/closed_form.yaml
# the model artifact final-eval scores, as name:alias or name:version
MODEL ?= happiness-regressor:candidate

# upload the train and test CSVs as dataset artifacts. Rerunning with unchanged files adds no version
register-data-artifacts:
	$(PYTHON) entrypoints/register_data.py

# one command: create the sweep, run every configuration, then write each run's verdict against the baseline.
# sweep.py prints the sweep's path on its last line, which is passed to the agent and to compare
run-sweep:
	@sweep=$$($(PYTHON) -m entrypoints.sweep $(SWEEP) | tail -n 1); \
	test -n "$$sweep" || { echo "the sweep was not created, see the error above"; exit 1; }; \
	$(PYTHON) -m wandb agent $$sweep && \
	$(PYTHON) -m entrypoints.compare $$sweep

# shortcuts: run-sweep with one specific sweep file. Add one per file in configs/sweeps/
run-dummy-sweep:
	@$(MAKE) -f Makefile.WeightsAndBiases run-sweep SWEEP=configs/sweeps/dummy.yaml

run-closed-form-sweep:
	@$(MAKE) -f Makefile.WeightsAndBiases run-sweep SWEEP=configs/sweeps/linear_regression/closed_form.yaml

run-sgd-sweep:
	@$(MAKE) -f Makefile.WeightsAndBiases run-sweep SWEEP=configs/sweeps/linear_regression/sgd.yaml

# redo the comparison of a finished sweep, ex against a different baseline run
compare:
	@test -n "$(SWEEP_ID)" || (echo "usage: make compare SWEEP_ID=<sweep_id> [BASELINE=<run_id>]"; exit 1)
	$(PYTHON) -m entrypoints.compare $(SWEEP_ID) $(BASELINE)

# refit one training run's config on all training rows and save the model as happiness-regressor:candidate
promote:
	@test -n "$(RUN)" || (echo "usage: make promote RUN=<run_id>"; exit 1)
	$(PYTHON) -m entrypoints.promote $(RUN)

# score the promoted model on the test set. Meant to run once, for the model already chosen
final-eval:
	$(PYTHON) -m entrypoints.final_eval $(MODEL)
